    "from datetime import datetime\n",
    "\n",
    "now=datetime.now()\n",
    "print(f\"Current date: {now.strftime(\"%d %m %y\")}\")\n",
    "print(f\"Current time: {now.min}\")\n",
    "print(f\"Current year: {now.year}\")\n",
    "print(f\"Current month: {now.month}\")\n",
    "print(f\"Current day: {now.day}\")\n"
   ]
